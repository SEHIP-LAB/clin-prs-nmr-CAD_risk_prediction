# Bash environment file. Copy to .env and edit before sourcing.
# Keep all authorized inputs and generated participant-level artifacts outside Git.
CHD_DATA_DIR=/absolute/path/to/authorized_ukb_exports
CHD_OUTPUT_ROOT=/absolute/path/to/cad_analysis_outputs

# Original cohort/search run; the score notebooks create separate derived runs.
CHD_RUN_ID=final_rerun_2026
CHD_COHORT_ID=prs_raw106_complete

# Updated Full249 run for confirmations, Coverage90 reference and selected-run panels.
CHD_PRIMARY_RUN_ID=reviewer_full249_score_5fold

CHD_CPU_WORKERS=4
CHD_INNER_THREADS=1
CHD_ETHNICITY_N_JOBS=24
CHD_BOOTSTRAP_N=1000
CHD_GPU_REQUIRED=1

# Optional authorized file containing Eid and baseline Field 21000.
# CHD_ETHNICITY_CSV=/absolute/path/to/ethnicity.csv

# Allow CPU fallback on machines without CUDA (does not force CPU if CUDA exists).
# CHD_GPU_REQUIRED=0

# Optional categorical NRI; fill only with the actual threshold justification.
# CHD_NRI_CUTPOINTS=0.05,0.10,0.20
# CHD_NRI_CUTPOINT_SOURCE='Actual prespecified threshold source'
